# Local mock mode uses only fictional examples; postgres requires a private DATABASE_URL.
# Set DATABASE_URL through the private process environment; no credentials belong here.
# Migrations and synthetic seeds are explicit commands, never startup side effects.
# The server reads process environment; this file is not automatically loaded.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATA_ADAPTER=mock
