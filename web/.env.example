# Public build-time settings only. Never put secrets in VITE_* variables.
# Copy to .env.local for development: every displayed mock record is fictional.
VITE_API_MODE=mock
# Same-origin base prefix. The contract already includes /api/v1/public paths.
VITE_PUBLIC_API_BASE_URL=
# Normal production builds require VITE_API_MODE=real. There is no mock fallback.
